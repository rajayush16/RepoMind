# Copy to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-64-char-string
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (application metadata) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=repomind
POSTGRES_USER=repomind
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://repomind:change-me@localhost:5432/repomind

# --- Redis (cache / Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Neo4j (code knowledge graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Qdrant (vector search) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- GitHub OAuth / API ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback
GITHUB_APP_WEBHOOK_SECRET=

# --- LLM providers (at least one required for AI features) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-sonnet-5

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
