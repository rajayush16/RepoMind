# Copy to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-64-char-string
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Fernet key (32 url-safe base64 bytes) used to encrypt GitHub tokens at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# --- PostgreSQL (application metadata) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=repomind
POSTGRES_USER=repomind
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://repomind:change-me@localhost:5432/repomind

# --- Redis (cache / Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Neo4j (code knowledge graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Qdrant (vector search) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- GitHub OAuth / API ---
# Register an OAuth App at https://github.com/settings/developers with this
# Authorization callback URL (must point at the BACKEND, not the frontend).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
GITHUB_APP_WEBHOOK_SECRET=

# --- LLM providers (at least one required for AI features) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=anthropic
# Leave blank to use that provider's own default model (see
# backend/app/services/llm/providers/*.py). Only set this to override it --
# it's passed through as-is, so it must match whichever provider you selected
# above (e.g. don't put an Anthropic model name here if the provider is openai).
DEFAULT_LLM_MODEL=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
